# Write the vectors afresh into OUT and compare them, file by file, with
# the committed ones in SRC: the committed vectors are exactly what this
# implementation writes (cmake -DVECTORS=... -DSRC=... -DOUT=... -P this).
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${VECTORS}" write "${OUT}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "nmz-vectors write failed")
endif()
file(GLOB fresh RELATIVE "${OUT}" "${OUT}/*")
file(GLOB committed RELATIVE "${SRC}" "${SRC}/*")
list(SORT fresh)
list(SORT committed)
if(NOT fresh STREQUAL committed)
  message(FATAL_ERROR "the committed vectors are not the files this implementation writes:\n  fresh: ${fresh}\n  committed: ${committed}")
endif()
set(bad "")
foreach(f IN LISTS fresh)
  file(SHA256 "${OUT}/${f}" a)
  file(SHA256 "${SRC}/${f}" b)
  if(NOT a STREQUAL b)
    list(APPEND bad "${f}")
  endif()
endforeach()
if(bad)
  message(FATAL_ERROR "these committed vectors differ from what this implementation writes: ${bad}")
endif()
list(LENGTH fresh n)
message(STATUS "${n} vector files, all the same as the committed ones")
